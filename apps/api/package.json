{
  "name": "@sars/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rm -rf .turbo dist"
  },
  "dependencies": {
    "@sars/schemas": "workspace:*",
    "@sars/types": "workspace:*",
    "@sars/utils": "workspace:*",
    "@trpc/server": "^11.0.0",
    "@trpc/client": "^11.0.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/cookie": "^11.0.0",
    "fastify-plugin": "^5.0.0",
    "drizzle-orm": "^0.38.0",
    "drizzle-kit": "^0.30.0",
    "postgres": "^3.4.0",
    "ioredis": "^5.4.0",
    "zod": "^3.24.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "bcrypt": "^5.1.0",
    "jose": "^5.9.0",
    "meilisearch": "^0.44.0",
    "socket.io": "^4.8.0",
    "bullmq": "^5.34.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@sars/config-tsconfig": "workspace:*",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "supertest": "^7.0.0"
  }
}
